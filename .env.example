# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Get a key at https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used across all lessons.
# Defaults to claude-opus-5. Use claude-haiku-4-5 to cut costs while iterating.
# GENAI_TUTORIAL_MODEL=claude-opus-5

# Optional: where the RAG lessons persist their vector index.
# GENAI_TUTORIAL_INDEX_DIR=.index
